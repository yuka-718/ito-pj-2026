{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "motif_recognizability": { "type": "integer", "minimum": 0, "maximum": 5 },
    "required_parts": { "type": "integer", "minimum": 0, "maximum": 5 },
    "proportion_balance": { "type": "integer", "minimum": 0, "maximum": 5 },
    "reference_similarity": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
    "pairwise_preference": {
      "type": "string",
      "enum": ["current", "best", "tie", "not_available"]
    },
    "summary": { "type": "string" },
    "issues": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    }
  },
  "required": [
    "motif_recognizability",
    "required_parts",
    "proportion_balance",
    "reference_similarity",
    "pairwise_preference",
    "summary",
    "issues"
  ],
  "additionalProperties": false
}
