{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "stop_reason": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    }
  },
  "required": ["score", "iterations", "stop_reason", "summary", "issues"],
  "additionalProperties": false
}
