{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "iterations": { "type": "integer", "minimum": 1, "maximum": 10 },
    "best_step": { "type": "integer", "minimum": 0, "maximum": 10 },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "issues": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer", "minimum": 1, "maximum": 10 },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "accepted": { "type": "boolean" },
          "action": { "type": "string" },
          "summary": { "type": "string" },
          "issues": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 6
          }
        },
        "required": ["step", "score", "accepted", "action", "summary", "issues"],
        "additionalProperties": false
      }
    }
  },
  "required": ["score", "iterations", "best_step", "stop_reason", "summary", "issues", "steps"],
  "additionalProperties": false
}
